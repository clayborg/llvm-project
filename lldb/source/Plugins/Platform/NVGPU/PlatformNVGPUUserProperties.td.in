include "../../../../include/lldb/Core/PropertiesBase.td"

let Definition = "platformnvgpuuser" in {
  def NvdisasmPath: Property<"nvdisasm-path", "FileSpec">,
    Global,
    DefaultStringValue<"@NVGPU_DISASSEMBLER_PATH@">,
    Desc<"Custom path to the nvdisasm binary. When not specified, LLDB will "
    "search PATH, CUDA_HOME/bin, common CUDA toolkit locations, and "
    "versioned /usr/local/cuda-* directories for an nvdisasm supporting the "
    "target SM architecture.">;
}
